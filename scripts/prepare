#!/usr/bin/bash
set -euxo pipefail
dnf -y copr enable @ai-ml/nvidia-container-toolkit
dnf -y install niri mako swaybg swayidle polkit-kde kf6-kirigami udiskie \
    libappindicator-gtk3 brightnessctl pavucontrol blueman network-manager-applet \
    nvidia-container-toolkit nvidia-container-toolkit-selinux \
    qemu-system-x86 qemu-img mkosi \
    @development-tools bubblewrap
dnf remove -y gnome-software gnome-software-rpm-ostree
dnf -y install --allowerasing vim-default-editor
sed -i 's|^Exec=|&/usr/bin/env XDG_CURRENT_DESKTOP=GNOME |' /usr/share/applications/org.gnome.Settings.desktop
mkdir -p /var/home/linuxbrew/.linuxbrew
useradd slate
chown -R slate:slate /home/linuxbrew
sudo -u slate /scripts/brew
userdel -r slate
mkdir -p /usr/lib/slate
mv /home/linuxbrew/.linuxbrew /usr/lib/slate/.linuxbrew
rm -rf /home/linuxbrew
